class CmdProbeColors(Command):
    NAME = "probe-colors"
    """Discover dominant colors in the current screenshot."""

    @classmethod
    def configure(cls, parser):
        parser.add_argument("--count", type=int, default=10)
        parser.add_argument("--exclude-bg", action="store_true")
        parser.add_argument("--scope", action="store_true", help="Restrict to active scope region")
        parser.add_argument("--tolerance", type=int, default=30)

    def run(self, args, state):
        from collections import Counter
        win = _require_window(state)
        geo = {"at": win["at"], "size": win["size"]}
        scale = get_monitor_scale(win.get("monitor", 0))
        scope = get_scope() if args.scope else None
        img_path = _scoped_snap(geo, scope, scale)
        from PIL import Image
        im = Image.open(img_path)
        small = im.resize((max(1, im.width // 4), max(1, im.height // 4)), Image.LANCZOS)
        pixels = [p[:3] for p in small.getdata()]
        if args.exclude_bg:
            pixels = [p for p in pixels if not (all(c < 20 for c in p) or all(c > 235 for c in p))]
        step = max(1, args.tolerance)
        buckets = Counter()
        for r, g, b in pixels:
            qr = (r // step) * step
            qg = (g // step) * step
            qb = (b // step) * step
            buckets[(qr, qg, qb)] += 1
        top = buckets.most_common(args.count)
        colors = []
        for (r, g, b), count in top:
            colors.append({
                "rgb": [r, g, b],
                "hex": f"{r:02x}{g:02x}{b:02x}",
                "pixels": count * 16,
            })
        try:
            os.unlink(img_path)
        except OSError:
            pass
        state.update({"ok": True, "colors": colors})
        return state


class CmdWaitChain(Command):
    NAME = "wait-chain"
    """Wait for a condition, then run a chain atomically."""

    @classmethod
    def configure(cls, parser):
        parser.add_argument("--wait-text", type=str)
        parser.add_argument("--wait-color", type=parse_color)
        parser.add_argument("--tolerance", type=int, default=0)
        parser.add_argument("--timeout", type=int, default=5000)
        parser.add_argument("--step", action="append")
        parser.add_argument("--upscale", action="store_true")
        parser.add_argument("--preprocess", action="store_true")
        parser.add_argument("--psm", type=int)
        parser.add_argument("--conf-min", type=float, default=0)
        parser.add_argument("--no-scope", action="store_true")

    def run(self, args, state):
        if not args.step:
            fail("bad_args", "wait-chain requires at least one --step", EXIT_BAD_ARGS)
        timeout = args.timeout
        end = time.time() + timeout / 1000.0
        win = _require_window(state)
        geo = {"at": win["at"], "size": win["size"]}
        scale = get_monitor_scale(win.get("monitor", 0))
        scope = get_scope() if not args.no_scope else None
        found = False
        while time.time() < end:
            img_path = _scoped_snap(geo, scope, scale)
            if args.wait_text is not None:
                words = _ocr_words(img_path, upscale=args.upscale, conf_min=args.conf_min, preprocess=args.preprocess, psm=args.psm)
                found = _find_text_target(words, args.wait_text) is not None
            elif args.wait_color is not None:
                found = _find_color_target(img_path, args.wait_color, args.tolerance) is not None
            else:
                fail("bad_args", "wait-chain requires --wait-text or --wait-color", EXIT_BAD_ARGS)
            try:
                os.unlink(img_path)
            except OSError:
                pass
            if found:
                break
            time.sleep(POLL_INTERVAL)
        if not found:
            fail("timeout", "Wait condition not met within timeout", EXIT_TIMEOUT)
        chain_cmd = CmdChain()
        chain_ns = argparse.Namespace(step=args.step)
        state = chain_cmd.run(chain_ns, state)
        state.update({"ok": True, "waited": True})
        return state


