# ── Custom exception for controlled exits ──
class LoveControlError(Exception):
    def __init__(self, data, code=EXIT_GENERAL):
        self.data = data
        self.code = code
        super().__init__(data.get("message", ""))


def fail(error_code, message, exit_code=EXIT_GENERAL, extra=None):
    data = {"ok": False, "error": error_code, "message": message}
    if extra:
        data.update(extra)
    raise LoveControlError(data, exit_code)


# ── JSON I/O & Pipeline State ──
def read_stdin_state():
    if sys.stdin.isatty():
        return None
    try:
        return json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return None


def require_keys(state, *keys):
    missing = [k for k in keys if k not in state]
    if missing:
        fail("bad_args", f"Missing required fields from stdin or args: {', '.join(missing)}", EXIT_BAD_ARGS)


# ── Core Infrastructure ──
def run(args, check=True, timeout=10):
    try:
        proc = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        if check and proc.returncode != 0:
            return None, f"command failed ({proc.returncode}): {proc.stderr.strip() or proc.stdout.strip()}", proc.returncode
        return proc.stdout, None, proc.returncode
    except subprocess.TimeoutExpired:
        return None, f"command timed out: {' '.join(args)}", None
    except FileNotFoundError:
        return None, f"command not found: {args[0]}", None


def find_love_window(max_wait=POLL_TIMEOUT):
    end = time.time() + max_wait
    while True:
        stdout, err, _ = run(["hyprctl", "clients", "-j"], check=False, timeout=5)
        if stdout:
            try:
                clients = json.loads(stdout)
            except json.JSONDecodeError:
                clients = []
            love_clients = []
            for c in clients:
                cls = c.get("class", "") or ""
                initial = c.get("initialClass", "") or ""
                if cls == "love" or initial == "love":
                    love_clients.append(c)
            if love_clients:
                focused = [c for c in love_clients if c.get("focused")]
                if focused:
                    return focused[0]
                return love_clients[0]
        if time.time() >= end:
            return None
        time.sleep(POLL_INTERVAL)


def focus_window(address):
    run(["hyprctl", "dispatch", "focuswindow", f"address:{address}"], check=False, timeout=5)


# ── Cursor helpers ──
_CURSOR_STACK = []

def push_cursor():
    stdout, err, _ = run(["hyprctl", "cursorpos", "-j"], check=False, timeout=3)
    if not stdout:
        _CURSOR_STACK.append(None)
        return
    try:
        pos = json.loads(stdout)
        _CURSOR_STACK.append((pos["x"], pos["y"]))
    except (json.JSONDecodeError, KeyError):
        _CURSOR_STACK.append(None)


def pop_cursor():
    if not _CURSOR_STACK:
        return
    pos = _CURSOR_STACK.pop()
    if pos is None:
        return
    x, y = pos
    run(["hyprctl", "dispatch", "movecursor", str(x), str(y)], check=False, timeout=3)


def hide_cursor_for_screenshot():
    push_cursor()
    run(["hyprctl", "dispatch", "movecursor", "0", "0"], check=False, timeout=3)


def unhide_cursor_after_screenshot():
    pop_cursor()


# ── Coordinate conversion ──
_MONITOR_SCALES = {}
_YDOTOOL_FACTOR = None

def get_monitor_scale(monitor_id):
    global _MONITOR_SCALES
    if monitor_id in _MONITOR_SCALES:
        return _MONITOR_SCALES[monitor_id]
    stdout, err, _ = run(["hyprctl", "monitors", "-j"], check=False, timeout=5)
    scale = 1.0
    if stdout:
        try:
            monitors = json.loads(stdout)
            for m in monitors:
                if m.get("id") == monitor_id:
                    scale = float(m.get("scale", 1.0))
                    break
        except (json.JSONDecodeError, ValueError):
            pass
    _MONITOR_SCALES[monitor_id] = scale
    return scale


def discover_ydotool_factor():
    pos_old, err, _ = run(["hyprctl", "cursorpos", "-j"], check=False, timeout=3)
    if err:
        return 1.0
    try:
        old = json.loads(pos_old)
        old_x, old_y = old["x"], old["y"]
    except (json.JSONDecodeError, KeyError):
        return 1.0
    _ydotool(["mousemove", "-a", "-x", "100", "-y", "100"])
    pos_new, err, _ = run(["hyprctl", "cursorpos", "-j"], check=False, timeout=3)
    run(["hyprctl", "dispatch", "movecursor", str(old_x), str(old_y)], check=False, timeout=3)
    if err:
        return 1.0
    try:
        new = json.loads(pos_new)
        new_x, new_y = new["x"], new["y"]
    except (json.JSONDecodeError, KeyError):
        return 1.0
    fx = new_x / 100.0
    fy = new_y / 100.0
    factor = (fx + fy) / 2.0
    if factor <= 0:
        factor = 1.0
    return factor


def get_ydotool_factor():
    global _YDOTOOL_FACTOR
    if _YDOTOOL_FACTOR is not None:
        return _YDOTOOL_FACTOR
    env = os.environ.get("LOVE_CONTROL_YDOTOOL_FACTOR")
    if env:
        try:
            _YDOTOOL_FACTOR = float(env)
            return _YDOTOOL_FACTOR
        except ValueError:
            pass
    if FACTOR_CACHE_FILE.exists():
        try:
            with open(FACTOR_CACHE_FILE) as f:
                cache = json.load(f)
            if time.time() - cache.get("ts", 0) < FACTOR_CACHE_TTL:
                _YDOTOOL_FACTOR = float(cache["factor"])
                return _YDOTOOL_FACTOR
        except (json.JSONDecodeError, ValueError, OSError, KeyError):
            pass
    _YDOTOOL_FACTOR = discover_ydotool_factor()
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        with open(FACTOR_CACHE_FILE, "w") as f:
            json.dump({"factor": _YDOTOOL_FACTOR, "ts": time.time()}, f)
    except OSError:
        pass
    return _YDOTOOL_FACTOR


def window_pixels_to_hypr(wx_logical, wy_logical, px_physical, py_physical, scale):
    return int(wx_logical + (px_physical / scale)), int(wy_logical + (py_physical / scale))


def hypr_to_ydotool(hx, hy, factor):
