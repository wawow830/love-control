class CmdFindText(Command):
    NAME = "find-text"
    """Find text coordinates in OCR word data."""

    @classmethod
    def configure(cls, parser):
        parser.add_argument("--text", type=str, required=True)
        parser.add_argument("--exact", action="store_true")
        parser.add_argument("--all", action="store_true")
        parser.add_argument("--conf-min", type=float, default=0)
        parser.add_argument("--save-scope", action="store_true")
        parser.add_argument("--padding", type=int, default=10)

    def run(self, args, state):
        words = state.get("words")
        if words is None:
            fail("bad_args", "find-text requires stdin with 'words'", EXIT_BAD_ARGS)
        found = _find_text_target(words, args.text, exact=args.exact, all_matches=args.all, conf_min=args.conf_min)
        if args.all:
            if not found:
                closest = _closest_text_words(words, args.text)
                fail("not_found", f"Text '{args.text}' not found", EXIT_NOT_FOUND, extra={"closest": closest})
            matches = []
            for (cx, cy, w) in found:
                entry = {"x": cx, "y": cy, "text": w["text"], "conf": w.get("conf", 0), "w": w["w"], "h": w["h"]}
                if args.save_scope:
                    padding = args.padding
                    entry["scope"] = {
                        "x": max(0, cx - w["w"] // 2 - padding),
                        "y": max(0, cy - w["h"] // 2 - padding),
                        "w": w["w"] + padding * 2,
                        "h": w["h"] + padding * 2,
                    }
                    set_scope(entry["scope"])
                matches.append(entry)
            state.update({"ok": True, "matches": matches})
        else:
            if found is None:
                closest = _closest_text_words(words, args.text)
                fail("not_found", f"Text '{args.text}' not found", EXIT_NOT_FOUND, extra={"closest": closest})
            cx, cy, w = found
            entry = {"ok": True, "x": cx, "y": cy, "text": w["text"], "conf": w.get("conf", 0), "w": w["w"], "h": w["h"]}
            if args.save_scope:
                padding = args.padding
                entry["scope"] = {
                    "x": max(0, cx - w["w"] // 2 - padding),
                    "y": max(0, cy - w["h"] // 2 - padding),
                    "w": w["w"] + padding * 2,
                    "h": w["h"] + padding * 2,
                }
                set_scope(entry["scope"])
            state.update(entry)
        return state


