# ── Key resolution ──
def resolve_love_key(name):
    name = name.strip().lower()
    code = KEY_MAP.get(name)
    if code is None:
        if name.startswith("0x"):
            try:
                code = int(name, 16)
            except ValueError:
                pass
        elif name.isdigit():
            code = int(name)
    if code is None:
        raise ValueError(f"unknown LÖVE key: {name}")
    return code


# ── Image / OCR helpers ──
def _levenshtein(a, b):
    n, m = len(a), len(b)
    if n == 0:
        return m
    if m == 0:
        return n
    prev = list(range(m + 1))
    curr = [0] * (m + 1)
    for i in range(1, n + 1):
        curr[0] = i
        for j in range(1, m + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            curr[j] = min(curr[j - 1] + 1, prev[j] + 1, prev[j - 1] + cost)
        prev, curr = curr, prev
    return prev[m]


def _image_hash(path):
    from PIL import Image
    im = Image.open(path)
    thumb = im.convert("L").resize((32, 32), Image.LANCZOS)
    return hashlib.md5(thumb.tobytes()).hexdigest()


def _words_to_lines(words):
    if not words:
        return []
    sorted_words = sorted(words, key=lambda w: (w["y"], w["x"]))
    lines = []
    current = [sorted_words[0]]
    for w in sorted_words[1:]:
        avg_h = sum(x["h"] for x in current) / len(current)
        if abs(w["y"] - current[-1]["y"]) <= avg_h * 0.75:
            current.append(w)
        else:
            lines.append(current)
            current = [w]
    lines.append(current)
    result = []
    for line in lines:
        line.sort(key=lambda w: w["x"])
        result.append(" ".join(w["text"] for w in line))
    return result


def _closest_text_words(words, target, n=3):
    target = target.strip().lower()
    candidates = []
    for w in words:
        text = w["text"].lower()
        dist = _levenshtein(target, text)
        candidates.append((dist, w["text"], w))
    candidates.sort(key=lambda x: x[0])
    seen = set()
    results = []
    for dist, text, w in candidates:
        if text not in seen:
            seen.add(text)
            results.append({"text": w["text"], "dist": dist, "x": w["x"], "y": w["y"]})
        if len(results) >= n:
            break
    return results


def _closest_color_info(img_path, color):
    from PIL import Image
    r, g, b = color
    im = Image.open(img_path)
    px = im.load()
    best_dist = float("inf")
    best = None
    for iy in range(im.height):
        for ix in range(im.width):
            pr, pg, pb = px[ix, iy][:3]
            d = ((pr - r) ** 2 + (pg - g) ** 2 + (pb - b) ** 2) ** 0.5
            if d < best_dist:
                best_dist = d
                best = {"color": [pr, pg, pb], "dist": round(d, 2), "x": ix, "y": iy}
    return best


def _preprocess_for_ocr(img_path):
    from PIL import Image, ImageOps, ImageFilter, ImageEnhance
    im = Image.open(img_path)
    gray = im.convert("L")
    pixels = list(gray.getdata())
    mean = sum(pixels) / len(pixels)
    if mean < 96:
        gray = ImageOps.invert(gray)
    enhancer = ImageEnhance.Contrast(gray)
    high_contrast = enhancer.enhance(2.0)
    binary = high_contrast.point(lambda p: 255 if p > 128 else 0, mode="1")
    binary = binary.filter(ImageFilter.MinFilter(3))
    binary = binary.filter(ImageFilter.MaxFilter(3))
    fd, path = tempfile.mkstemp(suffix=".png")
    os.close(fd)
    binary.convert("L").save(path)
    return path


def _ocr_words(img_path, upscale=False, conf_min=0, preprocess=False, psm=None):
    actual_path = img_path
    preprocessed_path = None
    upscaled_path = None
    if preprocess:
        preprocessed_path = _preprocess_for_ocr(img_path)
        actual_path = preprocessed_path
    if upscale:
        from PIL import Image
        im = Image.open(actual_path)
        w2, h2 = im.width * 2, im.height * 2
        im_up = im.resize((w2, h2), Image.LANCZOS)
        fd, upscaled_path = tempfile.mkstemp(suffix=".png")
        os.close(fd)
        im_up.save(upscaled_path)
        actual_path = upscaled_path
    tesseract_args = ["tesseract", actual_path, "stdout", "tsv"]
    if psm is not None:
        tesseract_args.extend(["--psm", str(psm)])
    stdout, err, _ = run(tesseract_args, check=False, timeout=15)
    if upscaled_path:
        try:
            os.unlink(upscaled_path)
        except OSError:
            pass
    if preprocessed_path:
        try:
            os.unlink(preprocessed_path)
        except OSError:
            pass
    if err:
        fail("cmd_failed", f"tesseract failed: {err}", EXIT_CMD_FAILED)
    words = []
    for line in stdout.strip().splitlines():
        parts = line.split("\t")
        if len(parts) >= 12 and parts[0].isdigit() and int(parts[0]) == 5:
            conf = parts[10] if len(parts) > 10 else "0"
            try:
                conf_val = float(conf)
            except ValueError:
                conf_val = 0.0
            if conf_val < conf_min:
                continue
            w = {
                "text": parts[11] if len(parts) > 11 else "",
                "x": int(parts[6]),
                "y": int(parts[7]),
                "w": int(parts[8]),
                "h": int(parts[9]),
                "conf": conf_val,
            }
            if upscale:
                w["x"] //= 2
                w["y"] //= 2
                w["w"] //= 2
                w["h"] //= 2
            words.append(w)
    return words


def _find_text_target(words, target, exact=False, all_matches=False, conf_min=0):
    target = target.strip()
    target_lc = target.lower()
    matches = []
    filtered = [w for w in words if w.get("conf", 100) >= conf_min]
    for w in filtered:
        if exact:
            if w["text"] == target:
                matches.append((w["x"] + w["w"] // 2, w["y"] + w["h"] // 2, w))
        else:
            if target_lc in w["text"].lower():
                matches.append((w["x"] + w["w"] // 2, w["y"] + w["h"] // 2, w))
    if not exact and " " in target and filtered:
        sorted_words = sorted(filtered, key=lambda w: (w["y"], w["x"]))
        lines = []
        current = [sorted_words[0]]
        for w in sorted_words[1:]:
            avg_h = sum(x["h"] for x in current) / len(current)
            if abs(w["y"] - current[-1]["y"]) <= avg_h * 0.75:
                current.append(w)
            else:
                lines.append(current)
                current = [w]
        lines.append(current)
        for line in lines:
            line.sort(key=lambda w: w["x"])
            joined = " ".join(w["text"] for w in line)
            if target_lc in joined.lower():
                x_min = min(w["x"] for w in line)
                x_max = max(w["x"] + w["w"] for w in line)
                y_min = min(w["y"] for w in line)
                y_max = max(w["y"] + w["h"] for w in line)
                synthetic = {
                    "text": joined,
                    "x": x_min,
                    "y": y_min,
                    "w": x_max - x_min,
                    "h": y_max - y_min,
                    "conf": min(w.get("conf", 100) for w in line),
                }
                matches.append(((x_min + x_max) // 2, (y_min + y_max) // 2, synthetic))
    if not matches:
        return [] if all_matches else None
    matches.sort(key=lambda m: (m[1], m[0]))
    return matches if all_matches else matches[0]


def _find_color_target(img_path, color, tolerance=0):
    from PIL import Image
    im = Image.open(img_path)
    px = im.load()
    r, g, b = color
    best = None
    best_dist = None
    for iy in range(im.height):
        for ix in range(im.width):
            pr, pg, pb = px[ix, iy][:3]
            if tolerance == 0:
                if pr == r and pg == g and pb == b:
                    return ix, iy
            else:
                d = ((pr - r) ** 2 + (pg - g) ** 2 + (pb - b) ** 2) ** 0.5
                if d <= tolerance:
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (ix, iy)
    return best


def _find_all_color_targets(img_path, color, tolerance):
    from PIL import Image
    im = Image.open(img_path)
    px = im.load()
    r, g, b = color
    cell = 20
    grid = {}
    for iy in range(im.height):
        for ix in range(im.width):
            pr, pg, pb = px[ix, iy][:3]
            d = ((pr - r) ** 2 + (pg - g) ** 2 + (pb - b) ** 2) ** 0.5
            if d <= tolerance:
                gx, gy = ix // cell, iy // cell
                if (gx, gy) not in grid:
                    grid[(gx, gy)] = [0, 0, 0]
                grid[(gx, gy)][0] += ix
                grid[(gx, gy)][1] += iy
                grid[(gx, gy)][2] += 1
    centers = []
    for (gx, gy), (sx, sy, c) in grid.items():
        centers.append((int(sx / c), int(sy / c), c))
    centers.sort(key=lambda m: (m[1], m[0]))
    return centers


# ── Screenshot ──
def _scoped_snap(geo, scope, scale=1.0):
    if scope:
        x = geo["at"][0] + int(scope["x"] / scale)
        y = geo["at"][1] + int(scope["y"] / scale)
        w = int(scope["w"] / scale)
        h = int(scope["h"] / scale)
    else:
        x = geo["at"][0]
        y = geo["at"][1]
        w = geo["size"][0]
        h = geo["size"][1]
    region = f"{x},{y} {w}x{h}"
    fd, path = tempfile.mkstemp(suffix=".png")
    os.close(fd)
    hide_cursor_for_screenshot()
    stdout, err, _ = run(["grim", "-g", region, path], check=False, timeout=10)
    unhide_cursor_after_screenshot()
    if err:
        try:
            os.unlink(path)
        except OSError:
            pass
        fail("cmd_failed", f"grim failed: {err}", EXIT_CMD_FAILED)
    return path


def _verify_change(geo, scope, before_path, scale=1.0):
    if before_path is None:
        return None
    after_path = _scoped_snap(geo, scope, scale)
    changed = _image_hash(before_path) != _image_hash(after_path)
    for p in (before_path, after_path):
        try:
            os.unlink(p)
        except OSError:
            pass
    return changed


# ── ydotool ──
def _ydotool(extra_args):
    stdout, err, rc = run(["ydotool"] + extra_args, check=False, timeout=10)
    if rc != 0:
        return err or f"ydotool exited with code {rc}"
    if err and "failed" in err.lower():
        return err
    return None


# ── Argument parsers ──
def parse_pos(s):
    try:
        x, y = map(int, s.split(","))
        return x, y
    except ValueError:
        raise argparse.ArgumentTypeError(f"invalid position '{s}', expected x,y")


def parse_color(s):
    try:
        parts = s.replace(",", " ").split()
        if len(parts) != 3:
            raise ValueError
        r, g, b = map(int, parts)
        if not (0 <= r <= 255 and 0 <= g <= 255 and 0 <= b <= 255):
            raise ValueError
        return r, g, b
    except ValueError:
        raise argparse.ArgumentTypeError(f"invalid color '{s}', expected r,g,b (0-255)")


def parse_coords(s):
    try:
        parts = s.replace(",", " ").split()
        if len(parts) != 4:
            raise ValueError
        return tuple(map(int, parts))
    except ValueError:
        raise argparse.ArgumentTypeError(f"invalid coords '{s}', expected x1 y1 x2 y2")


# ── Window helper for pipeline ──
def _require_window(state):
    address = state.get("address")
    if address:
        stdout, err, _ = run(["hyprctl", "clients", "-j"], check=False, timeout=5)
        if stdout:
            try:
                clients = json.loads(stdout)
            except json.JSONDecodeError:
                clients = []
            for c in clients:
                if c.get("address") == address:
                    cls = c.get("class", "") or ""
                    initial = c.get("initialClass", "") or ""
                    if cls == "love" or initial == "love":
                        state["geometry"] = {"x": c["at"][0], "y": c["at"][1], "w": c["size"][0], "h": c["size"][1]}
                        state["monitor"] = c.get("monitor", 0)
                        return c
    win = find_love_window(max_wait=POLL_TIMEOUT)
    if win is None:
        fail("no_window", "No LÖVE window found", EXIT_NO_WINDOW)
    state["address"] = win.get("address")
    state["geometry"] = {"x": win["at"][0], "y": win["at"][1], "w": win["size"][0], "h": win["size"][1]}
    state["monitor"] = win.get("monitor", 0)
    state["title"] = win.get("title")
    return win


def _resolve_pos(args, state, attr_name):
    val = getattr(args, attr_name, None)
    if val is not None:
        return val
    x = state.get("x")
    y = state.get("y")
    if x is not None and y is not None:
        return x, y
    return None, None


def _resolve_relative_pos(px, py, scope, relative):
    if relative:
        if scope is None:
            fail("no_scope", "--relative used but no scope is active", EXIT_BAD_ARGS)
        return px + scope["x"], py + scope["y"]
    return px, py


