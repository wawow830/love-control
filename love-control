        parser.add_argument("--step", action="append", help="Command string to run")
        parser.add_argument("--no-focus", action="store_true", help="Skip focusing the LÖVE window at chain start")

    def run(self, args, state):
        if not args.step:
            fail("bad_args", "chain requires at least one --step", EXIT_BAD_ARGS)
        if not args.no_focus:
            win = _require_window(state)
            focus_window(win["address"])
        registry = get_command_registry()
        for step in args.step:
            parts = step.strip().split()
            if not parts:
                continue
            cmd_name = parts[0]
            cmd_cls = registry.get(cmd_name)
            if cmd_cls is None:
                fail("bad_args", f"Unknown command in chain: {cmd_name}", EXIT_BAD_ARGS)
            sub_parser = argparse.ArgumentParser(prog=f"love-control {cmd_name}", add_help=False)
            cmd_cls.configure(sub_parser)
            try:
                sub_args = sub_parser.parse_args(parts[1:])
            except SystemExit:
                fail("bad_args", f"Invalid arguments for chain step: {step}", EXIT_BAD_ARGS)
            cmd = cmd_cls()
            state = cmd.run(sub_args, state)
        state["ok"] = True
        return state


class CmdWait(Command):
    NAME = "wait"
    """Poll until a condition is met or timeout."""

    @classmethod
    def configure(cls, parser):
        parser.add_argument("--timeout", type=int, default=5000)
        parser.add_argument("--step", action="append", help="Chain step to poll")
        parser.add_argument("--text", type=str)
        parser.add_argument("--exact-text", action="store_true")
        parser.add_argument("--color", type=parse_color)
        parser.add_argument("--tolerance", type=int, default=0)
        parser.add_argument("--no-scope", action="store_true")
        parser.add_argument("--upscale", action="store_true")
        parser.add_argument("--preprocess", action="store_true")
        parser.add_argument("--psm", type=int)
        parser.add_argument("--conf-min", type=float, default=0)

    def run(self, args, state):
        timeout = args.timeout
        end = time.time() + timeout / 1000.0
        if args.step:
            chain_cmd = CmdChain()
            chain_ns = argparse.Namespace(step=args.step)
            while time.time() < end:
                try:
                    tmp_state = dict(state)
                    tmp_state = chain_cmd.run(chain_ns, tmp_state)
                    state.update(tmp_state)
                    return state
                except LoveControlError:
                    pass
                time.sleep(POLL_INTERVAL)
            fail("timeout", "Wait condition not met within timeout", EXIT_TIMEOUT)
        elif args.text is not None or args.color is not None:
            win = _require_window(state)
            geo = {"at": win["at"], "size": win["size"]}
            scale = get_monitor_scale(win.get("monitor", 0))
            scope = get_scope() if not args.no_scope else None
            while time.time() < end:
                img_path = _scoped_snap(geo, scope, scale)
                found = False
                if args.text is not None:
                    words = _ocr_words(img_path, upscale=args.upscale, conf_min=args.conf_min, preprocess=args.preprocess, psm=args.psm)
                    found = _find_text_target(words, args.text, args.exact_text) is not None
                else:
                    found = _find_color_target(img_path, args.color, args.tolerance) is not None
                try:
                    os.unlink(img_path)
                except OSError:
                    pass
                if found:
                    state.update({"ok": True, "found": True})
                    return state
                time.sleep(POLL_INTERVAL)
            fail("timeout", "Wait condition not met within timeout", EXIT_TIMEOUT)
        else:
            fail("bad_args", "wait requires --step, --text, or --color", EXIT_BAD_ARGS)


class CmdAssert(Command):
    NAME = "assert"
    """Assert that state contains expected fields/values."""

    @classmethod
    def configure(cls, parser):
        parser.add_argument("--has", action="append", help="Require field existence")
        parser.add_argument("--eq", action="append", help="field=value")

    def run(self, args, state):
        if args.has:
            for field in args.has:
                if field not in state:
                    fail("assert_failed", f"Assertion failed: missing field '{field}'", EXIT_GENERAL)
        if args.eq:
            for pair in args.eq:
                if "=" not in pair:
                    fail("bad_args", "--eq requires field=value", EXIT_BAD_ARGS)
                field, val = pair.split("=", 1)
                if str(state.get(field)) != val:
                    fail("assert_failed", f"Assertion failed: {field} != {val}", EXIT_GENERAL)
        state.update({"ok": True, "assert": True})
        return state


