class CmdClick(Command):
    NAME = "click"
    """Click at window-relative coordinates."""

    @classmethod
    def configure(cls, parser):
        parser.add_argument("--pos", type=parse_pos, help="x,y")
        parser.add_argument("--relative", action="store_true")
        parser.add_argument("--button", choices=["left", "right", "middle"], default="left")
        parser.add_argument("--duration", type=int, help="Hold duration in ms")
        parser.add_argument("--offset", type=parse_pos, default=(0, 0))
        parser.add_argument("--verify", action="store_true")

    def run(self, args, state):
        win = _require_window(state)
        geo = {"at": win["at"], "size": win["size"]}
        scale = get_monitor_scale(win.get("monitor", 0))
        factor = get_ydotool_factor()
        focus_window(win["address"])
        scope = get_scope()
        px, py = _resolve_pos(args, state, "pos")
        if px is None or py is None:
            fail("bad_args", "click requires --pos x,y or stdin with x,y", EXIT_BAD_ARGS)
        px, py = _resolve_relative_pos(px, py, scope, args.relative)
        ox, oy = args.offset
        px += ox
        py += oy
        hx, hy = window_pixels_to_hypr(geo["at"][0], geo["at"][1], px, py, scale)
        yx, yy = hypr_to_ydotool(hx, hy, factor)
        verify = args.verify
        if verify:
            hide_cursor_for_screenshot()
        before_path = None
        try:
            if verify:
                before_path = _scoped_snap(geo, scope, scale)
            err = _ydotool(["mousemove", "-a", "-x", str(yx), "-y", str(yy)])
            if err:
                fail("cmd_failed", f"ydotool mousemove failed: {err}", EXIT_CMD_FAILED)
            btn = MOUSE_BUTTONS.get(args.button, MOUSE_BUTTONS["left"])
            if args.duration is not None and args.duration > 0:
                err = _ydotool(["click", btn["down"]])
                if err:
                    fail("cmd_failed", f"ydotool click down failed: {err}", EXIT_CMD_FAILED)
                time.sleep(args.duration / 1000.0)
                err = _ydotool(["click", btn["up"]])
                if err:
                    fail("cmd_failed", f"ydotool click up failed: {err}", EXIT_CMD_FAILED)
            else:
                err = _ydotool(["click", btn["click"]])
                if err:
                    fail("cmd_failed", f"ydotool click failed: {err}", EXIT_CMD_FAILED)
            changed = _verify_change(geo, scope, before_path, scale)
            out = {"ok": True, "x": px, "y": py, "hypr": {"x": hx, "y": hy}, "ydotool": {"x": yx, "y": yy}}
            if changed is not None:
                out["changed"] = changed
            state.update(out)
            return state
        finally:
            if verify:
                unhide_cursor_after_screenshot()


class CmdDrag(Command):
    NAME = "drag"
    """Drag from one point to another."""

    @classmethod
    def configure(cls, parser):
        parser.add_argument("--from", dest="from_pos", type=parse_pos)
        parser.add_argument("--to", dest="to_pos", type=parse_pos)
        parser.add_argument("--duration", type=int, default=500)
        parser.add_argument("--button", choices=["left", "right", "middle"], default="left")
        parser.add_argument("--relative", action="store_true")
        parser.add_argument("--verify", action="store_true")

    def run(self, args, state):
        win = _require_window(state)
        geo = {"at": win["at"], "size": win["size"]}
        scale = get_monitor_scale(win.get("monitor", 0))
        factor = get_ydotool_factor()
        focus_window(win["address"])
        scope = get_scope()
        x1, y1 = _resolve_pos(args, state, "from_pos")
        x2, y2 = _resolve_pos(args, state, "to_pos")
        if None in (x1, y1, x2, y2):
            if args.from_pos and state.get("x") is not None:
                x1, y1 = args.from_pos
                x2, y2 = state["x"], state["y"]
            else:
                fail("bad_args", "drag requires --from and --to (or stdin x,y as destination with --from)", EXIT_BAD_ARGS)
        x1, y1 = _resolve_relative_pos(x1, y1, scope, args.relative)
        x2, y2 = _resolve_relative_pos(x2, y2, scope, args.relative)
        hx1, hy1 = window_pixels_to_hypr(geo["at"][0], geo["at"][1], x1, y1, scale)
        hx2, hy2 = window_pixels_to_hypr(geo["at"][0], geo["at"][1], x2, y2, scale)
        yx1, yy1 = hypr_to_ydotool(hx1, hy1, factor)
        yx2, yy2 = hypr_to_ydotool(hx2, hy2, factor)
        verify = args.verify
        if verify:
            hide_cursor_for_screenshot()
        before_path = None
        try:
            if verify:
                before_path = _scoped_snap(geo, scope, scale)
            err = _ydotool(["mousemove", "-a", "-x", str(yx1), "-y", str(yy1)])
            if err:
                fail("cmd_failed", f"ydotool mousemove failed: {err}", EXIT_CMD_FAILED)
            btn = MOUSE_BUTTONS.get(args.button, MOUSE_BUTTONS["left"])
            err = _ydotool(["click", btn["down"]])
            if err:
                fail("cmd_failed", f"ydotool click down failed: {err}", EXIT_CMD_FAILED)
            duration = args.duration
            steps = max(2, min(10, int(duration / 50)))
            for i in range(1, steps + 1):
                t = i / steps
                hx = int(hx1 + (hx2 - hx1) * t)
                hy = int(hy1 + (hy2 - hy1) * t)
                yx, yy = hypr_to_ydotool(hx, hy, factor)
                err = _ydotool(["mousemove", "-a", "-x", str(yx), "-y", str(yy)])
                if err:
                    _ydotool(["click", btn["up"]])
                    fail("cmd_failed", f"ydotool mousemove failed during drag: {err}", EXIT_CMD_FAILED)
                time.sleep(duration / 1000.0 / steps)
            err = _ydotool(["click", btn["up"]])
            if err:
                fail("cmd_failed", f"ydotool click up failed: {err}", EXIT_CMD_FAILED)
            changed = _verify_change(geo, scope, before_path, scale)
            out = {"ok": True, "from": {"x": x1, "y": y1}, "to": {"x": x2, "y": y2}}
            if changed is not None:
                out["changed"] = changed
            state.update(out)
            return state
        finally:
            if verify:
                unhide_cursor_after_screenshot()


