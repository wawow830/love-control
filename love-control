class CmdScope(Command):
    NAME = "scope"
    """Get, set, or clear the active scope."""

    @classmethod
    def configure(cls, parser):
        parser.add_argument("action", choices=["get", "set", "clear"], nargs="?", default="get")
        parser.add_argument("--coords", type=parse_coords, help="x1 y1 x2 y2")
        parser.add_argument("--text", type=str)
        parser.add_argument("--exact-text", action="store_true")
        parser.add_argument("--color", type=parse_color)
        parser.add_argument("--tolerance", type=int, default=0)
        parser.add_argument("--padding", type=int, default=10)
        parser.add_argument("--upscale", action="store_true")
        parser.add_argument("--preprocess", action="store_true")
        parser.add_argument("--psm", type=int)
        parser.add_argument("--conf-min", type=float, default=0)

    def run(self, args, state):
        if args.action == "clear":
            set_scope(None)
            state.update({"ok": True, "scope": None})
            return state
        if args.action == "get":
            scope = get_scope()
            state.update({"ok": True, "scope": scope})
            return state
        if args.action == "set":
            if args.coords is not None:
                x1, y1, x2, y2 = args.coords
                x = min(x1, x2)
                y = min(y1, y2)
                w = abs(x2 - x1)
                h = abs(y2 - y1)
                scope = {"x": x, "y": y, "w": w, "h": h}
                set_scope(scope)
                state.update({"ok": True, "scope": scope})
                return state
            if args.text is not None or args.color is not None:
                win = _require_window(state)
                geo = {"at": win["at"], "size": win["size"]}
                img_path = _scoped_snap(geo, None)
                padding = args.padding
                if args.text is not None:
                    words = _ocr_words(img_path, upscale=args.upscale, conf_min=args.conf_min, preprocess=args.preprocess, psm=args.psm)
                    found = _find_text_target(words, args.text, args.exact_text)
                    os.unlink(img_path)
                    if found is None:
                        closest = _closest_text_words(words, args.text)
                        fail("not_found", f"Text '{args.text}' not found", EXIT_NOT_FOUND, extra={"closest": closest})
                    img_x, img_y, w = found
                    scope = {
                        "x": max(0, img_x - w["w"] // 2 - padding),
                        "y": max(0, img_y - w["h"] // 2 - padding),
                        "w": w["w"] + padding * 2,
                        "h": w["h"] + padding * 2,
                    }
                else:
                    found = _find_color_target(img_path, args.color, args.tolerance)
                    os.unlink(img_path)
                    if found is None:
                        closest = _closest_color_info(img_path, args.color)
                        fail("not_found", f"Color {args.color} not found", EXIT_NOT_FOUND, extra={"closest": closest})
                    img_x, img_y = found
                    scope = {
                        "x": max(0, img_x - padding),
                        "y": max(0, img_y - padding),
                        "w": 1 + padding * 2,
                        "h": 1 + padding * 2,
                    }
                set_scope(scope)
                state.update({"ok": True, "scope": scope})
                return state
            x = state.get("x")
            y = state.get("y")
            w = state.get("w")
            h = state.get("h")
            if None in (x, y, w, h):
                fail("bad_args", "scope set requires --coords, --text, --color, or stdin with x,y,w,h", EXIT_BAD_ARGS)
            scope = {"x": x, "y": y, "w": w, "h": h}
            set_scope(scope)
            state.update({"ok": True, "scope": scope})
            return state


