def get_command_registry():
    classes = [
        CmdWindow, CmdFocus, CmdSnap, CmdOcr, CmdFindText, CmdFindColor,
        CmdLines, CmdMove, CmdClick, CmdDrag, CmdKey, CmdType, CmdScope,
        CmdRead, CmdChain, CmdWait, CmdAssert,
        CmdClickText, CmdClickColor, CmdProbeColors, CmdWaitChain,
    ]
    return {cls.NAME: cls for cls in classes}


def main():
    registry = get_command_registry()
    parser = argparse.ArgumentParser(prog="love-control", description="Modular, pipeable LÖVE2D automation")
    sub = parser.add_subparsers(dest="command", required=True)
    for cls in registry.values():
        cls.add_parser(sub)
    parser.add_argument("--raw", type=str, help="Output only this field as plain text")
    args = parser.parse_args()
    raw_field = args.raw
    cmd_cls = registry[args.command]
    cmd = cmd_cls()
    state = read_stdin_state() or {}
    try:
        state = cmd.run(args, state)
        if raw_field:
            val = state.get(raw_field)
            if val is None:
                fail("bad_args", f"Field '{raw_field}' not found in output", EXIT_BAD_ARGS)
            if isinstance(val, (list, dict)):
                print(json.dumps(val, separators=(",", ":")))
            else:
                print(val)
            sys.exit(EXIT_SUCCESS)
        print(json.dumps(state, separators=(",", ":")))
        sys.exit(EXIT_SUCCESS)
    except LoveControlError as e:
        print(json.dumps(e.data, separators=(",", ":")))
        sys.exit(e.code)


if __name__ == "__main__":
    main()
